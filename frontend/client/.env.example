# ==============================================================================
# SumitUp AI Meet - Frontend Environment Configuration Template
# Copy this file to .env in frontend/client/
# ==============================================================================

# Backend API Base URL (FastAPI backend running on port 8080)
VITE_API_URL=http://localhost:8080/api/v1

# Dev/Preview Server Options (Optional)
# Comma-separated list of allowed domains (e.g. danishansari.me,www.danishansari.me) or "true" to allow all
# ALLOWED_HOSTS=danishansari.me,www.danishansari.me
# HOST=0.0.0.0
# PORT=5173
