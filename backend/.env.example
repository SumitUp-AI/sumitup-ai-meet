# ==============================================================================
# SumitUp AI Meet - Backend Environment Configuration Template
# Copy this file to .env and fill in the values for your local development.
# ==============================================================================

# --- LLM & AI Services ---
# Hugging Face Access Token (for embeddings and model downloads)
HF_TOKEN=your_huggingface_token

# Groq API Key (for LLM summarization and action items extraction)
GROQ_API_KEY=your_groq_api_key

# Google Gemini API Key (optional / alternative LLM integration)
GOOGLE_API_KEY=your_google_gemini_api_key

# Cohere API Key (for RAG document reranking)
COHERE_API_KEY=your_cohere_api_key


# --- Authentication & App Security ---
# Secret key used for signing JWT access tokens (e.g., openssl rand -hex 32)
SECRET_KEY=your_jwt_secret_key

# Secret key used for signing JWT refresh tokens
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# 32-character key for data encryption
ENCRYPTION_KEY=development_secret_key_32_bytes_long

# Environment mode: 'development' or 'production' (production enables Sentry error tracking)
ENVIRONMENT=development

# Sentry DSN (optional in development)
SENTRY_DSN=


# --- Database Configuration ---
# MongoDB URI (Local MongoDB or MongoDB Atlas connection string)
MONGO_URI=mongodb://localhost:27017

# MongoDB Atlas URI (Optional: leave empty if using local MONGO_URI)
MONGODB_ATLAS_URI=

# Database Name
DB_NAME=test


# --- Meeting Bot & Attendee Integration ---
# Attendee Cloud API Key
ATTENDEE_API_KEY=your_attendee_api_key

# Attendee API Base URL (Default cloud endpoint: https://app.attendee.dev)
ATTENDEE_SERVICE_URL=https://app.attendee.dev

# Secret key for verifying incoming webhook signatures from Attendee
WEBHOOK_SECRET=your_attendee_webhook_secret


# --- Speech-To-Text (STT) Providers ---
# Deepgram API Key (STT provider for real-time transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key

# AssemblyAI API Key (STT provider for meeting transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key


# --- Zoom OAuth Configuration ---
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URI=http://localhost:8080/api/v1/zoom/callback/


# --- Email Notifications (SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_app_password


# --- Client / Frontend Configuration ---
# Frontend application URL for CORS and invitation links
CLIENT_URL=http://localhost:5173/
